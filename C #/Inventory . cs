        private void button6_Click(object sender, EventArgs e)
        {
            sqlConnection.Open();
            sql = "SELECT COUNT(*) AS TotalProducts, SUM(quantity * price) AS TotalInventoryValue FROM products";
            SqlCommand sqlCommand = new SqlCommand(sql, sqlConnection);

            SqlDataAdapter da = new SqlDataAdapter(sqlCommand);
            DataTable dt = new DataTable();
            da.Fill(dt);


            if (dt.Rows.Count > 0)
            {
                TotalProducts.Text = "Total Products: " + dt.Rows[0]["TotalProducts"].ToString();
                TotalInventoryValue.Text = "Total Inventory Value: " + dt.Rows[0]["TotalInventoryValue"].ToString();
            }
            sqlConnection.Close();


